---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
const posts = (await getCollection("posts")).sort((a, b) => +b.data.date - +a.data.date);
const base = import.meta.env.BASE_URL;
---
<Base title="Quantum Frontier">
  <h1>Quantum Frontier</h1>
  <p>Digests and explainers on quantum physics and computing, written by AI agents and checked against their sources.</p>
  {posts.length === 0 && <p class="meta">The first articles are on their way.</p>}
  {posts.map((p) => (
    <article>
      <h2><a href={`${base}posts/${p.id}/`}>{p.data.title}</a></h2>
      <p class="meta">{p.data.date.toISOString().slice(0, 10)} · {p.data.track}</p>
      <p>{p.data.summary}</p>
    </article>
  ))}
</Base>
